HTML_JS = """
const q = document.getElementById('q');
const st = document.getElementById('st');
function apply() {
  const v = q.value.toLowerCase();
  const s = st.value;
  document.querySelectorAll('article.entry').forEach(a => {
    const okText = !v || a.textContent.toLowerCase().includes(v);
    const okStatus = !s || a.dataset.status === s;
    a.classList.toggle('hide', !(okText && okStatus));
  });
  document.querySelectorAll('section.bucket').forEach(sec => {
    const any = sec.querySelectorAll('article.entry:not(.hide)').length > 0;
    sec.style.display = any ? '' : 'none';
  });
}
q.addEventListener('input', apply);
st.addEventListener('change', apply);
"""


def generate_html(kb_dir, repo_root, config, entries, index_md_text):
    entry_ids = {f"{bucket}/{path.name}" for bucket, path in entries}
    parsed_entries = []
    for bucket, path in entries:
        parsed = parse_entry(path)
        parsed_entries.append((bucket, path, parsed))

    def entry_titles():
        t = {}
        for bucket, path, parsed in parsed_entries:
            t[f"{bucket}/{path.name}"] = parsed["front"].get("title", path.name) or path.name
        return t
    titles = entry_titles()

    ready = read_manual_region(index_md_text, "ready-answers", DEFAULT_READY)

    out = []
    out.append("<!DOCTYPE html>")
    out.append('<html lang="en"><head><meta charset="utf-8">')
    out.append('<meta name="viewport" content="width=device-width, initial-scale=1">')
    out.append("<title>Knowledge Database</title>")
    out.append("<style>" + HTML_CSS + "</style></head><body>")
    out.append('<header class="top"><h1>Knowledge Database</h1>')
    out.append('<input id="q" type="search" placeholder="Search titles, text, tags...">')
    out.append('<select id="st"><option value="">all statuses</option>'
               '<option value="verified">verified (proven)</option>'
               '<option value="tentative">tentative (unconfirmed)</option>'
               '<option value="superseded">superseded (replaced)</option></select>')
    out.append("</header>")
    out.append('<div class="layout"><nav class="side">')
    for bucket in config.get("buckets", {}):
        rows = [(b, p, pr) for b, p, pr in parsed_entries if b == bucket]
        rows.sort(key=lambda r: (str(r[2]["front"].get("date", "")), r[1].name), reverse=True)
        out.append(f"<h2>{_esc(HTML_BUCKET_LABELS.get(bucket, bucket))}</h2>")
        if not rows:
            out.append('<span class="empty">nothing yet</span>')
        for b, p, pr in rows:
            rel = f"{b}/{p.name}"
            status = pr["front"].get("status", "")
            out.append(f'<a href="#{rel}"><span class="dot {_esc(str(status))}"></span>'
                       f"{_esc(str(pr['front'].get('title', p.name)))}</a>")
    out.append("</nav><main>")

    out.append("<h2>Start here: ready answers</h2>")
    out.append('<p class="bucket-blurb">Topic &rarr; the one place to look first.</p>')
    out.append(_md_to_html(ready, entry_ids))

    out.append('<h2>How to read this page</h2>')
    out.append('<p class="bucket-blurb"><span class="badge verified">verified</span> proven, with captured '
               'evidence shown in the Proof box &nbsp;<span class="badge tentative">tentative</span> best '
               'understanding, not yet proven &nbsp;<span class="badge superseded">superseded</span> outdated, '
               'links to its replacement. Every claim cites real files: expand a source to see the exact lines '
               'it is grounded in (captured when this page was generated).</p>')

    for bucket, blurb in config.get("buckets", {}).items():
        rows = [(b, p, pr) for b, p, pr in parsed_entries if b == bucket]
        rows.sort(key=lambda r: (str(r[2]["front"].get("date", "")), r[1].name), reverse=True)
        out.append(f'<section class="bucket"><h2>{_esc(HTML_BUCKET_LABELS.get(bucket, bucket))}'
                   f' <span class="tags">({_esc(bucket)}/ &mdash; {_esc(blurb)})</span></h2>')
        if not rows:
            out.append('<p class="empty">Nothing recorded yet.</p>')
        for b, p, pr in rows:
            rel = f"{b}/{p.name}"
            front = pr["front"]
            status = str(front.get("status", ""))
            out.append(f'<article class="entry" id="{_esc(rel)}" data-status="{_esc(status)}">')
            out.append(f"<h2>{_esc(str(front.get('title', p.name)))}</h2>")
            out.append('<div class="meta">')
            out.append(f'<span class="badge {_esc(status)}">{_esc(status)}</span>')
            out.append(f'<span class="badge">{_esc(str(front.get("date", "")))}</span>')
            lv = front.get("last_verified")
            if isinstance(lv, str) and lv:
                out.append(f'<span class="badge">re-verified {_esc(lv)}</span>')
            db = front.get("decision_by")
            if isinstance(db, str) and db:
                out.append(f'<span class="badge">decided by: {_esc(db)}</span>')
            tags = front.get("tags", [])
            if isinstance(tags, list) and tags:
                out.append(f'<span class="tags">{_esc(", ".join(tags))}</span>')
            out.append("</div>")

            related = front.get("related", []) if isinstance(front.get("related"), list) else []
            if status == "superseded" and related:
                links = ", ".join(
                    f'<a href="#{_esc(r)}">{_esc(str(titles.get(r, r)))}</a>' if r in entry_ids else _esc(r)
                    for r in related)
                out.append(f'<div class="banner">Outdated &mdash; replaced by: {links}</div>')

            for name, text in pr["sections"].items():
                if name == "Verification":
                    out.append('<div class="proof"><h3>Proof (verification evidence)</h3>')
                    out.append(_md_to_html(text, entry_ids))
                    out.append("</div>")
                else:
                    out.append(f"<h3>{_esc(name)}</h3>")
                    out.append(_md_to_html(text, entry_ids))

            sources = front.get("sources", []) if isinstance(front.get("sources"), list) else []
            if sources:
                out.append('<div class="proof"><h3>Grounded in (cited source lines)</h3>')
                for src in sources:
                    snippet = _source_snippet(repo_root, src)
                    if snippet is None:
                        out.append(f'<div class="tags">{_esc(src)}</div>')
                    else:
                        out.append(f'<details class="src"><summary>{_esc(src)}</summary>'
                                   f"<pre><code>{_esc(snippet)}</code></pre></details>")
                out.append("</div>")

            if status != "superseded" and related:
                links = ", ".join(
                    f'<a href="#{_esc(r)}">{_esc(str(titles.get(r, r)))}</a>' if r in entry_ids else _esc(r)
                    for r in related)
                out.append(f'<p class="tags">Related: {links}</p>')
            out.append("</article>")
        out.append("</section>")

    out.append("</main></div>")
    out.append("<script>" + HTML_JS + "</script>")
    out.append("</body></html>")

    entry_pairs = [(f"{b}/{p.name}", p.read_text(encoding="utf-8")) for b, p in entries]
    fp = kb_fingerprint(index_md_text, entry_pairs)
    out.insert(1, f"<!-- kb:fingerprint:{fp} -->")
    return "\n".join(out) + "\n"


# ---------------------------------------------------------------- git / diff

def git_lines(repo_root, args):
    import subprocess
    try:
        proc = subprocess.run(["git", "-C", str(repo_root)] + args,
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    return [l for l in proc.stdout.split("\n") if l.strip()]


def changed_paths(repo_root, staged, diff_base):
    if staged:
        return git_lines(repo_root, ["diff", "--cached", "--name-only"])
    if diff_base:
        return git_lines(repo_root, ["diff", "--name-only", f"{diff_base}...HEAD"])
    return None


def kb_evidence(kb_dir, config, changed, kb_prefix, cross_repo):
    """Did this unit of work produce KB movement?

    Same-repo: the diff itself must contain a KB path — the original rule.
    Cross-repo (context workspace: code in a NESTED repo, KB in the parent):
    the KB can never appear in the nested repo's diff, so the write-back gate
    would silently pass forever. Instead look for pending KB changes in the
    workspace, or a KB commit inside writeback.grace_hours (default 24).
    """
    if not cross_repo:
        return any(p.startswith(kb_prefix) for p in changed)
    grace = float(config.get("writeback", {}).get("grace_hours", 24))
    kb_repo = owning_repo(kb_dir)
    if kb_repo is not None:
        if git_lines(kb_repo, ["status", "--porcelain", "--", str(kb_dir)]):
            return True
        stamp = git_lines(kb_repo, ["log", "-1", "--format=%ct", "--", str(kb_dir)])
        if not stamp:
            return False
        try:
            return (time.time() - int(stamp[0])) / 3600.0 <= grace
        except ValueError:
            return True
    # KB is not under version control: fall back to entry mtimes.
    newest = 0.0
    for bucket in config.get("buckets", {}):
        bucket_dir = kb_dir / bucket
        if bucket_dir.is_dir():
            for entry in bucket_dir.glob("*.md"):
                newest = max(newest, entry.stat().st_mtime)
    return newest > 0 and (time.time() - newest) / 3600.0 <= grace


def check_diff_rules(kb_dir, repo_root, config, changed, findings, diff_root=None):
    diff_root = diff_root or repo_root
    cross_repo = owning_repo(diff_root) != owning_repo(kb_dir)
    kb_prefix = str(kb_dir.relative_to(repo_root)) + "/"
    # KB009: lockstep pairs
    for pair in config.get("lockstep", []):
        src, doc = pair.get("source", ""), pair.get("doc", "")
        src_hit = [p for p in changed if glob_match(src, p)]
        if src_hit and not any(glob_match(doc, p) for p in changed):
            findings.append(Finding("KB009", src_hit[0],
                                    f"changed, but lockstep pair '{doc}' untouched in this diff"))
    # KB011: write-back trigger
    wb = config.get("writeback", {})
    recorded = kb_evidence(kb_dir, config, changed, kb_prefix, cross_repo)
    where = f"in {kb_dir}" if cross_repo else "in this diff"
    code_hits = [p for p in changed
                 if any(glob_match(g, p) for g in wb.get("code", []))
                 and not any(glob_match(g, p) for g in wb.get("exempt", []))]
    if code_hits and not recorded:
        buckets = ", ".join(f"{b}/" for b in config.get("buckets", {}))
        findings.append(Finding("KB011", code_hits[0],
                                f"code changed but no {kb_prefix} entry touched {where} — "
                                f"record the work (likely bucket: solutions/ for features, errors/ for fixes; "
                                f"all buckets: {buckets})"))
    # KB013: doc write-back trigger (decision-bearing docs)
    doc_hits = [p for p in changed
                if any(glob_match(g, p) for g in wb.get("docs", []))
                and not any(glob_match(g, p) for g in wb.get("exempt", []))]
    if doc_hits and not recorded:
        findings.append(Finding("KB013", doc_hits[0],
                                f"decision-bearing doc changed but no {kb_prefix} entry touched {where} — "
                                f"a doc edit that states a rule, constraint, or choice is a decision: "
                                f"record it (likely bucket: decisions/)"))


# ---------------------------------------------------------------- commands

def plant_block(kb_name):
    """The HARD RULE block install.sh plants into every agent runtime file.

    Generated here so the rule-ID range can never drift from what the tool
    actually enforces, and so install.sh can compare a planted block against
    the canonical text and replant when it is stale.
    """
    return f"""{PLANT_MARKER_START}
## HARD RULE: Knowledge Database

This repo keeps durable memory in `{kb_name}/`. For EVERY task:

1. **LOOK UP FIRST** — one call: `{kb_name}/bin/kb find "<keywords>" -s` (hits plus the top
   hit's fix). Start there, not with `ls`, `grep` or a full read of `INDEX.md` — the search
   reads a generated index, so it stays one file read however large the KB grows. A
   `verified` entry is proven: apply it instead of re-deriving it.
2. **REUSE ENDS THE TASK** — if an entry already answered it, you are done when you refresh
   THAT entry: bump `last_verified` with fresh proof, or add a one-line reuse note. Never
   author a duplicate of an entry you just used — the write-back costs more than the lookup
   saved, and it splits one answer into two.
3. **EMPTY KB** — if no (relevant) entries exist, say so and suggest either a codebase
   exploration to seed it (`{kb_name}/bin/kb discover <dir>`), or manual document/context
   input to ingest (`{kb_name}/bin/kb ingest`). Then continue the task.
4. **NEVER PROMPT, NEVER WITHHOLD** — create, update, and supersede KB entries autonomously,
   as insights occur. Superseding a verified entry needs a stated reason and a `related:`
   link to the replacement — never permission.
5. **WRITE BACK NEW KNOWLEDGE** — work the KB did not already hold (search, multi-file reads,
   debugging, decisions) ends with an entry, stating the fix as a diff or `file:line` list.
   `{kb_name}/bin/kb check` must exit 0.

Full rules: `{kb_name}/AGENT.md`. Rule table ({RULE_RANGE}): `{kb_name}/README.md`.
{PLANT_MARKER_END}
"""


def planted_region(text):
    """The marker-delimited block inside `text`, or None."""
    if PLANT_MARKER_START not in text or PLANT_MARKER_END not in text:
        return None
    body = text.split(PLANT_MARKER_START, 1)[1].split(PLANT_MARKER_END, 1)[0]
    return PLANT_MARKER_START + body + PLANT_MARKER_END + "\n"


def check_rule_block_drift(kb_dir, repo_root, config, findings):
    """KB014 (warning): a planted rule block that no longer matches the tool.

    install.sh is marker-guarded, so before v0.7.0 a block planted by an older
    version stayed frozen forever while the rules moved on. Detect that here so
    the drift is visible from `kb check`, not only from `install.sh --check`.
    """
    expected = plant_block(kb_dir.name)
    for rel, _kind in RULE_TARGETS:
        target = repo_root / rel
        if not target.is_file():
            continue
        try:
            current = planted_region(target.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError):
            continue
        if current is not None and current != expected:
            findings.append(Finding("KB014", rel,
                                    "planted HARD RULE block is stale (does not match "
                                    f"kb {KB_TOOL_VERSION}) — run `{kb_dir.name}/install.sh` to replant",
                                    warning=True))


def cmd_rules(kb_dir, repo_root, config, args):
    """Print the agent hard-rules block for prompt injection.

    Designed as the command of a UserPromptSubmit hook: stdout is appended to
    the agent's context on EVERY prompt, so the rules are active immediately
    after install and cannot fall out of context mid-session.
    """
    kb_name = kb_dir.name if kb_dir.parent == repo_root else str(kb_dir.relative_to(repo_root))
    if getattr(args, "targets", False):
        for rel, kind in RULE_TARGETS:
            print(f"{rel}|{kind}")
        return 0
    if getattr(args, "plant", False):
        print(plant_block(kb_name), end="")
        return 0
    buckets = ", ".join(f"{b}/" for b in config.get("buckets", {}))
    if config.get("supersede_with_consent") is True:
        rule3 = ("4. CREATE/UPDATE FREELY, ASK BEFORE SUPERSEDING — this KB sets "
                 "supersede_with_consent: true,\n   so replacing a verified entry needs the user's "
                 "go-ahead (everything else stays autonomous).")
    else:
        rule3 = ("4. NEVER PROMPT — create/update/supersede autonomously; superseding a verified "
                 "entry needs\n   a stated reason + related: link.")
    print(f"""<kb-hard-rules source="{kb_name}/AGENT.md">
Durable memory: {kb_name}/ ({buckets}). Every non-trivial task:
1. LOOK UP FIRST — ONE call: `{kb_name}/bin/kb find "<keywords>" -s`. Not ls/grep/INDEX.md.
   A verified entry is proven: apply it, don't re-derive it.
2. REUSE ENDS IT — if an entry answered it, refresh THAT entry (bump last_verified with fresh proof,
   or add a one-line reuse note) and stop. Never duplicate an entry you just used.
3. EMPTY KB — nothing relevant: say so, suggest `kb discover <dir>` / `kb ingest`, continue.
{rule3}
5. WRITE BACK NEW KNOWLEDGE ONLY — work the KB didn't already hold gets an entry NOW
   (`kb new <type> <slug>`), fix stated as a diff or file:line list, not a story.
`kb check` must exit 0. Full rules: {kb_name}/AGENT.md.
</kb-hard-rules>""")
    return 0


def check_version_drift(kb_dir, config, findings, repo_root=None):
    # KB014 (warning-only): the installed config records which tool version wrote
    # it; a mismatch means tooling and config were upgraded independently.
    kb_rel = kb_dir.name
    declared = config.get("kb_version")
    if declared is None:
        findings.append(Finding("KB014", f"{kb_rel}/kb.config.json",
                                f"no kb_version recorded — add \"kb_version\": \"{KB_TOOL_VERSION}\" "
                                f"so upgrade drift is visible", warning=True))
    elif declared != KB_TOOL_VERSION:
        findings.append(Finding("KB014", f"{kb_rel}/kb.config.json",
                                f"kb_version {declared} != tool version {KB_TOOL_VERSION} — "
                                f"finish the upgrade (see UPGRADING.md), then bump kb_version",
                                warning=True))
    if repo_root is not None:
        newer = newer_upstream(kb_dir, repo_root)
        if newer:
            findings.append(Finding("KB014", f"{kb_rel}/bin/kb",
                                    f"tool is {installed_version(kb_dir)}; {newer} is available — "
                                    f"run `{kb_rel}/bin/kb upgrade`", warning=True))


CHANGELOG_VERSION_RE = re.compile(r"^##\s+.*\[(\d+\.\d+\.\d+)\]")
CHANGELOG_ART_RE = re.compile(r"^##\s+!\[[^\]]*\]\(([^)]+\.svg)\)\s+\[(\d+\.\d+\.\d+)\]")


def check_changelog_art(repo_root, config, findings):
    # KB015 (config-gated): every released version heading in the changelog
    # carries a small SVG artwork at the LEFT of the title. The art must exist,
    # live under the declared dir, and be unique per version (the "random
    # animal per release" practice — distinctness is the mechanical proxy).
    art_cfg = config.get("changelog_art")
    if not art_cfg:
        return
    rel_file = art_cfg.get("file", "CHANGELOG.md")
    art_dir = art_cfg.get("dir", "images/changelog")
    log_path = repo_root / rel_file
    if not log_path.is_file():
        findings.append(Finding("KB015", rel_file, "changelog_art configured but file missing"))
        return
    seen = {}
    for n, line in enumerate(log_path.read_text(encoding="utf-8").splitlines(), 1):
        m_ver = CHANGELOG_VERSION_RE.match(line)
        if not m_ver:
            continue
        ver = m_ver.group(1)
        m_art = CHANGELOG_ART_RE.match(line)
        if not m_art:
            findings.append(Finding("KB015", f"{rel_file}:{n}",
                                    f"version [{ver}] heading lacks SVG art left of the title — "
                                    f"add a small animal SVG under {art_dir}/ as "
                                    f"## ![name]({art_dir}/v{ver}-<animal>.svg) [{ver}] - <date>"))
            continue
        art = m_art.group(1)
        if not art.startswith(art_dir.rstrip("/") + "/"):
            findings.append(Finding("KB015", f"{rel_file}:{n}",
                                    f"version [{ver}] art '{art}' is outside the declared dir {art_dir}/"))
        if not (repo_root / art).is_file():
            findings.append(Finding("KB015", f"{rel_file}:{n}",
                                    f"version [{ver}] art file '{art}' does not exist"))
        if art in seen:
            findings.append(Finding("KB015", f"{rel_file}:{n}",
                                    f"version [{ver}] reuses art '{art}' (already used by [{seen[art]}]) — "
                                    f"each release gets its own animal"))
        else:
            seen[art] = ver


def cmd_version(kb_dir, repo_root, config, args):
    declared = config.get("kb_version", "unrecorded")
    print(f"kb tool version: {KB_TOOL_VERSION}")
    print(f"kb.config.json kb_version: {declared}")
    # Local sources only unless --check: printing a version must never block on
    # the network. --check may clone, and refreshes the cached answer.
    if getattr(args, "check", False):
        import shutil
        src, version, origin, tmp = resolve_source(repo_root, allow_network=True, kb_dir=kb_dir)
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)
        if version:
            cache_upstream(kb_dir, version, origin)
            print(f"upstream: {version} ({origin})")
        else:
            print(f"upstream: unknown — {origin}")
    newer = newer_upstream(kb_dir, repo_root)
    if newer:
        print(f"upstream: {newer} available — run `{kb_dir.name}/bin/kb upgrade`")
    return 0


def cmd_check(kb_dir, repo_root, config, args):
    findings = []
    today = date.today()
    check_version_drift(kb_dir, config, findings, repo_root)
    check_rule_block_drift(kb_dir, repo_root, config, findings)
    check_changelog_art(repo_root, config, findings)
    entries = collect_entries(kb_dir, config, findings)
    fronts = []
    for bucket, path in entries:
        fronts.append(check_entry(kb_dir, repo_root, config, bucket, path, findings, today))

    # KB007: INDEX.md matches generated output byte-for-byte
    index_path = kb_dir / "INDEX.md"
    generated = generate_index(kb_dir, repo_root, config, fronts)
    kb_rel = str(kb_dir.relative_to(repo_root)) if kb_dir != repo_root else kb_dir.name
    if not index_path.is_file():
        findings.append(Finding("KB007", f"{kb_rel}/INDEX.md", "missing — run `kb index`"))
    elif index_path.read_text(encoding="utf-8") != generated:
        findings.append(Finding("KB007", f"{kb_rel}/INDEX.md",
                                "does not match generated output — run `kb index` (never hand-edit outside manual regions)"))

    # KB012: INDEX.html (human-facing view) is fresh w.r.t. KB content
    html_path = kb_dir / "INDEX.html"
    if not html_path.is_file():
        findings.append(Finding("KB012", f"{kb_rel}/INDEX.html", "missing — run `kb index`"))
    else:
        m = re.search(r"kb:fingerprint:([0-9a-f]{64})", html_path.read_text(encoding="utf-8"))
        entry_pairs = [(f"{b}/{p.name}", p.read_text(encoding="utf-8")) for b, p in entries]
        expected = kb_fingerprint(generated, entry_pairs)
        if not m or m.group(1) != expected:
            findings.append(Finding("KB012", f"{kb_rel}/INDEX.html",
                                    "stale (fingerprint mismatch with entries/INDEX) — run `kb index`"))

    if args.staged or args.diff_base:
        diff_root = Path(args.repo).resolve() if getattr(args, "repo", None) else repo_root
        changed = changed_paths(diff_root, args.staged, args.diff_base)
        if changed is None:
            findings.append(Finding("KB009", str(diff_root), "cannot compute git diff for diff-mode rules",
                                    warning=True))
        else:
            check_diff_rules(kb_dir, repo_root, config, changed, findings, diff_root)

    errors = [f for f in findings if not f.warning]
    warnings = [f for f in findings if f.warning]
    if args.json:
        print(json.dumps({
            "ok": not errors,
            "findings": [{"rule": f.rule, "file": f.file, "message": f.message} for f in errors],
            "warnings": [{"rule": f.rule, "file": f.file, "message": f.message} for f in warnings],
        }, indent=2))
    else:
        for f in errors + warnings:
            print(f.line())
        if errors:
            print(f"kb check: {len(errors)} finding(s)")
    return 1 if errors else 0


# ---------------------------------------------------------------- lookup
# The cheap path. Reading INDEX.md end-to-end and then a whole entry costs
# thousands of tokens per reuse; most of it is catalog rows and prose the
# reader does not need. `find` returns matching entries only, `show` returns
# the part you act on.

STOPWORDS = {"the", "a", "an", "is", "in", "of", "and", "or", "to", "for", "on",
             "how", "why", "what", "when", "does", "do", "with", "it", "this"}

SEARCH_DIGEST = ".search-index.json"   # dot-prefixed: KB002 ignores it


def entries_stat_fingerprint(kb_dir, config):
    """Cheap staleness signal: stat every entry, read none of them."""
    h = hashlib.sha256()
    for bucket, path in entry_files(kb_dir, config):
        try:
            st = path.stat()
        except OSError:
            continue
        h.update(f"{bucket}/{path.name}:{st.st_mtime_ns}:{st.st_size}\n".encode("utf-8"))
    return h.hexdigest()


def build_digest(kb_dir, config):
    """One pass over the entries, one read each, high-signal fields only.

    Deliberately does NOT store bodies: that would just be a second copy of the
    KB. Body text is what `--deep` is for.
    """
    rows = []
    for bucket, path in entry_files(kb_dir, config):
        text = path.read_text(encoding="utf-8", errors="replace")
        parsed = parse_text(text)
        front = parsed["front"]
        summary = ""
        for name in ("Summary", "Fix", "Symptom"):
            body = parsed["sections"].get(name)
            if body and body.strip():
                summary = " ".join(body.strip().split())[:400]
                break
        rows.append({
            "rel": f"{bucket}/{path.name}",
            "bucket": bucket,
            "title": str(front.get("title", "")),
            "status": str(front.get("status", "")),
            "date": str(front.get("date", "")),
            "tags": front.get("tags", []) if isinstance(front.get("tags"), list) else [],
            "sources": front.get("sources", []) if isinstance(front.get("sources"), list) else [],
            "summary": summary,
        })
    return {"fingerprint": entries_stat_fingerprint(kb_dir, config), "entries": rows}


def write_digest(kb_dir, config):
    digest = build_digest(kb_dir, config)
    try:
        (kb_dir / SEARCH_DIGEST).write_text(json.dumps(digest, indent=1) + "\n",
                                            encoding="utf-8")
    except OSError:
        pass
    return digest


def load_digest(kb_dir, config):
    """The digest, rebuilt if missing or stale. Never serves a stale answer."""
    path = kb_dir / SEARCH_DIGEST
    current = entries_stat_fingerprint(kb_dir, config)
    if path.is_file():
        try:
            digest = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(digest, dict) and digest.get("fingerprint") == current:
                return digest, False
        except (OSError, json.JSONDecodeError):
            pass
    return write_digest(kb_dir, config), True

# Sections worth printing when someone is about to APPLY an entry, in order.
ACTIONABLE = ["Fix", "Summary", "Prevention", "Root Cause", "Decision",
              "Findings / What We Did"]


def entry_files(kb_dir, config):
    for bucket in config.get("buckets", {}):
        bucket_dir = kb_dir / bucket
        if bucket_dir.is_dir():
            for path in sorted(bucket_dir.glob("*.md")):
                yield bucket, path


def score_row(terms, row):
    """Rank a digest row. Title/tag hits are almost always the answer."""
    title = row.get("title", "").lower()
    tags = " ".join(row.get("tags", [])).lower()
    slug = row.get("rel", "").lower()
    summary = row.get("summary", "").lower()
    sources = " ".join(row.get("sources", [])).lower()
    score = 0
    for term in terms:
        if term in title:
            score += 8
        if term in tags:
            score += 4
        if term in slug:
            score += 3
        score += min(summary.count(term), 3) * 2
        if term in sources:
            score += 1
    return score


def first_section(parsed, names):
    for name in names:
        body = parsed["sections"].get(name)
        if body and body.strip():
            return name, body.strip()
    return None, ""


def trim_words(text, max_chars):
    text = " ".join(text.split())
    return text if len(text) <= max_chars else text[:max_chars].rsplit(" ", 1)[0] + " ..."


def trim(text, max_lines):
    lines = [l for l in text.split("\n") if l.strip()]
    out = lines[:max_lines]
    if len(lines) > max_lines:
        out.append("...")
    return "\n".join(out)


def cmd_find(kb_dir, repo_root, config, args):
    """Two tiers, cheapest first.

    Tier 1 reads ONE file (the generated digest) and ranks titles, tags, slugs,
    summaries and cited paths. Tier 2 opens the entry bodies, and only runs when
    tier 1 found nothing or --deep was asked for. Deep scores are tier-1 scores
    plus body matches, so the two tiers can never disagree on ordering.
    """
    terms = [t for t in re.split(r"[^\w-]+", args.query.lower()) if t and t not in STOPWORDS]
    if not terms:
        fail("nothing to search for")

    digest, rebuilt = load_digest(kb_dir, config)
    rows = digest.get("entries", [])
    scored = [(score_row(terms, row), row) for row in rows]
    hits = [(sc, row) for sc, row in scored if sc]
    tier = "index"

    if args.deep or not hits:
        tier = "deep"
        base = {row["rel"]: sc for sc, row in scored}
        hits = []
        for bucket, path in entry_files(kb_dir, config):
            rel = f"{bucket}/{path.name}"
            body = path.read_text(encoding="utf-8", errors="replace").lower()
            extra = sum(min(body.count(term), 5) for term in terms)
            total = base.get(rel, 0) + extra
            if total:
                row = next((r for r in rows if r["rel"] == rel), {"rel": rel})
                hits.append((total, row))

    hits.sort(key=lambda h: (-h[0], h[1].get("rel", "")))
    hits = hits[: args.limit]
    if not hits:
        print(f"no KB entry matches {args.query!r} — nothing recorded yet. "
              f"Explore, then record what you learn ({kb_dir.name}/bin/kb new <type> <slug>).")
        return 1

    for score, row in hits:
        print(f"{row.get('rel', '?')}  [{row.get('status', '?')}]")
        if row.get("title"):
            print(f"  {row['title']}")
        if args.full:
            path = kb_dir / row["rel"]
            print()
            print(path.read_text(encoding="utf-8", errors="replace").rstrip())
            print()
            continue
        if row.get("summary"):
            print("  " + trim_words(row["summary"], 240))
        sources = row.get("sources") or []
        if sources:
            shown = ", ".join(sources[:4])
            print(f"  sources: {shown}{' ...' if len(sources) > 4 else ''}")
    if args.full:
        return 0

    note = "" if tier == "index" else "  (deep scan: no title/tag/summary match)"
    if args.show:
        # One invocation instead of two: every `kb` call pays ~55ms of startup,
        # so an agent that needs the fix should not have to spawn `show` as well.
        top = hits[0][1].get("rel")
        if top:
            print()
            print("-" * 60)

            class _ShowArgs:
                entry = top
                all = False
                lines = args.lines
            cmd_show(kb_dir, repo_root, config, _ShowArgs)
        return 0
    print(f"\n{kb_dir.name}/bin/kb show <entry>   # the fix, without the prose{note}")
    return 0


def resolve_entry(kb_dir, config, needle):
    """Accept bucket/file.md, a bare filename, or a unique slug fragment."""
    candidates = []
    for bucket, path in entry_files(kb_dir, config):
        rel = f"{bucket}/{path.name}"
        if needle in (rel, path.name, path.stem):
            return bucket, path
        if needle.lower() in path.stem.lower():
            candidates.append((bucket, path))
    if len(candidates) == 1:
        return candidates[0]
    if not candidates:
        fail(f"no entry matches {needle!r} (try `kb find`)")
    names = ", ".join(f"{b}/{p.name}" for b, p in candidates[:6])
    fail(f"{needle!r} matches several entries: {names}")


def cmd_show(kb_dir, repo_root, config, args):
    bucket, path = resolve_entry(kb_dir, config, args.entry)
    text = path.read_text(encoding="utf-8", errors="replace")
    if args.all:
        print(text.rstrip())
        return 0
    parsed = parse_text(text)
    front = parsed["front"]
    print(f"{bucket}/{path.name}  [{front.get('status', '?')}]  {front.get('title', '')}")
    sources = front.get("sources", [])
    if isinstance(sources, list) and sources:
        print("sources: " + ", ".join(sources))
    related = front.get("related", [])
    if isinstance(related, list) and related:
        print("related: " + ", ".join(related))
    printed = 0
    for name in ACTIONABLE:
        body = parsed["sections"].get(name)
        if body and body.strip():
            print()
            print(f"## {name}")
            print(trim(body.strip(), args.lines))
            printed += 1
        if printed >= 3:
            break
    if not printed:
        print()
        print(trim(text, args.lines))
    print(f"\n(full entry: {kb_dir.name}/bin/kb show {args.entry} --all)")
    return 0


# ---------------------------------------------------------------- upgrade

def version_tuple(text):
    try:
        return tuple(int(part) for part in text.split("."))
    except (AttributeError, ValueError):
        return None


def source_candidates(repo_root):
    """Where a newer copy of the tool might already be on disk, best first.

    Same order as the plugin's bootstrap.sh: a plugin install already has the
    marketplace clone, and a developer usually has a checkout nearby, so the
    common upgrade needs no network at all.
    """
    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    out = []
    if plugin_root:
        out.append(Path(plugin_root).parent)
    out.append(Path.home() / ".claude/plugins/marketplaces/knowledge-database")
    out.append(repo_root.parent / "knowledge-database")
    out.append(repo_root / "knowledge-database")
    return out


def read_source_version(src):
    """Tool version of a candidate source tree, or None if it is not one."""
    tool = Path(src) / "knowledge-db" / "bin" / "kb"
    if not tool.is_file():
        return None
    m = VERSION_RE.search(tool.read_text(encoding="utf-8", errors="replace"))
    return m.group(1) if m else None


def installed_version(kb_dir):
    """Tool version of the KB being operated on.

    Not always this process's version: a KB installed before v0.7.0 has no
    `upgrade` subcommand, so it is upgraded by running the NEW tool with
    `--kb-dir <their KB>`. Comparing against the running tool there would
    report the source's version as "installed" and refuse to do anything.
    """
    tool = kb_dir / "bin" / "kb"
    if tool.is_file():
        try:
            m = VERSION_RE.search(tool.read_text(encoding="utf-8", errors="replace"))
        except OSError:
            m = None
        if m:
            return m.group(1)
    return KB_TOOL_VERSION


def resolve_source(repo_root, allow_network=True, explicit=None, kb_dir=None):
    import shutil
    import subprocess
    import tempfile
    """(source_path, version, origin_label, tempdir_to_clean). Never raises.

    Picks the NEWEST local candidate rather than the first one found: a machine
    can easily hold several checkouts (a plugin marketplace clone pinned to an
    old commit, plus a current one), and "update to latest" must not resolve to
    whichever happens to be earlier in the list. If every local source is at or
    behind the running tool, a clone is attempted so a genuinely newer upstream
    is still reachable.
    """
    if explicit:
        version = read_source_version(explicit)
        if version is None:
            fail(f"not a knowledge-database checkout: {explicit}")
        return Path(explicit).resolve(), version, str(explicit), None

    best, best_version = None, None
    for candidate in source_candidates(repo_root):
        version = read_source_version(candidate)
        if not version:
            continue
        if best_version is None or (version_tuple(version) or (0,)) > (version_tuple(best_version) or (0,)):
            best, best_version = Path(candidate).resolve(), version
    mine = version_tuple(installed_version(kb_dir) if kb_dir else KB_TOOL_VERSION) or (0,)
    if best is not None and (version_tuple(best_version) or (0,)) > mine:
        return best, best_version, str(best), None

    if not allow_network:
        if best is not None:
            return best, best_version, str(best), None
        return None, None, "no local checkout found (--no-network)", None
    tmp = tempfile.mkdtemp(prefix="kb.upstream-")
    clone = Path(tmp) / "knowledge-database"
    proc = subprocess.run(["git", "clone", "--depth", "1", "-q", UPSTREAM_REPO, str(clone)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        shutil.rmtree(tmp, ignore_errors=True)
        detail = (proc.stderr.strip().splitlines() or ["unknown error"])[-1]
        if best is not None:
            return best, best_version, f"{best} (clone failed: {detail})", None
        return None, None, f"clone failed: {detail}", None
    version = read_source_version(clone)
    if version is None:
        shutil.rmtree(tmp, ignore_errors=True)
        return None, None, "cloned tree has no bin/kb", None
    # A local checkout can still be ahead of the published default branch.
    if best is not None and (version_tuple(best_version) or (0,)) > (version_tuple(version) or (0,)):
        shutil.rmtree(tmp, ignore_errors=True)
        return best, best_version, str(best), None
    return clone, version, UPSTREAM_REPO, tmp


def cache_upstream(kb_dir, version, origin):
    try:
        (kb_dir / UPGRADE_CACHE).write_text(
            json.dumps({"version": version, "origin": origin}, indent=2) + "\n",
            encoding="utf-8")
    except OSError:
        pass


def cached_upstream(kb_dir):
    try:
        data = json.loads((kb_dir / UPGRADE_CACHE).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data.get("version") if isinstance(data, dict) else None


def newer_upstream(kb_dir, repo_root, probe_local=True):
    """Upstream version string when it beats the running tool, else None.

    `probe_local` reads local candidate sources (cheap, offline) and refreshes
    the cache; otherwise only the cache is consulted. Never touches the network.
    """
    # Deliberately does NOT write the cache: `kb check` calls this, and a check
    # must not mutate the KB it is validating.
    found = None
    if probe_local:
        for candidate in source_candidates(repo_root):
            version = read_source_version(candidate)
            if version and version_tuple(version) and \
                    version_tuple(version) > (version_tuple(found) if found else (0, 0, 0)):
                found = version
    if found is None:
        found = cached_upstream(kb_dir)
    mine, theirs = version_tuple(installed_version(kb_dir)), version_tuple(found)
    if mine and theirs and theirs > mine:
        return found
    return None


def cmd_upgrade(kb_dir, repo_root, config, args):
    """Vendor a newer tool version into this KB. Tooling only, entries untouched."""
    import shutil
    import subprocess
    import tempfile
    src, version, origin, tmp = resolve_source(repo_root, not args.no_network, args.source,
                                               kb_dir=kb_dir)
    try:
        if src is None:
            print(f"kb upgrade: no source available — {origin}", file=sys.stderr)
            print("            clone the repo and pass --source <path>, or follow UPGRADING.md",
                  file=sys.stderr)
            return 1
        local = installed_version(kb_dir)
        mine, theirs = version_tuple(local), version_tuple(version)
        cache_upstream(kb_dir, version, origin)
        print(f"source      {origin} ({version})")
        print(f"installed   {local}")
        if mine and theirs and theirs <= mine and not args.force:
            print("already current — nothing to do (use --force to re-vendor anyway)")
            return 0

        changing = []
        for rel in TOOLING_FILES:
            source_file = src / "knowledge-db" / rel
            if not source_file.is_file():
                continue
            target = kb_dir / rel
            if not target.is_file() or target.read_bytes() != source_file.read_bytes():
                changing.append(rel)
        # Config keys the newer default config has and this one does not: worth
        # showing, never merged silently — the config is the project's own.
        new_keys = []
        template = src / ".kb-templates" / "kb.config.json"
        if template.is_file():
            try:
                upstream_cfg = json.loads(template.read_text(encoding="utf-8"))
                new_keys = [k for k in upstream_cfg if k not in config]
            except json.JSONDecodeError:
                new_keys = []

        if args.dry_run:
            print(f"would vendor {' '.join(changing) if changing else '(no file changes)'}")
            print("would keep   entries, INDEX.*, kb.config.json vocabularies")
            if mine != theirs:
                print(f"would bump   kb_version {config.get('kb_version', 'unrecorded')} -> {version}")
            if new_keys:
                print(f"new config keys upstream (optional): {', '.join(new_keys)}")
            return 0

        backup = tempfile.mkdtemp(prefix="kb.backup-")
        shutil.copytree(kb_dir, Path(backup) / kb_dir.name)
        print(f"backup      {Path(backup) / kb_dir.name}")

        for rel in changing:
            source_file = src / "knowledge-db" / rel
            target = kb_dir / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source_file, target)
            if rel.startswith("bin/") or rel.endswith(".sh"):
                target.chmod(0o755)
        print(f"vendored    {' '.join(changing) if changing else '(no file changes)'}")
        print("kept        entries, INDEX.*, kb.config.json vocabularies")

        if config.get("kb_version") != version:
            config_path = kb_dir / "kb.config.json"
            raw = json.loads(config_path.read_text(encoding="utf-8"))
            previous = raw.get("kb_version", "unrecorded")
            raw["kb_version"] = version
            config_path.write_text(json.dumps(raw, indent=2) + "\n", encoding="utf-8")
            print(f"bumped      kb_version {previous} -> {version}")
        if new_keys:
            print(f"new config keys upstream (optional, not applied): {', '.join(new_keys)}")
    finally:
        if tmp:
            shutil.rmtree(tmp, ignore_errors=True)

    # From here on the vendored tool is NEWER than this running process, so
    # every follow-up step must go through the new binary, not these functions.
    new_kb = str(kb_dir / "bin" / "kb")
    subprocess.run([new_kb, "index"], capture_output=True, text=True)
    print("reindexed   INDEX.md + INDEX.html")

    if not args.no_install:
        installer = kb_dir / "install.sh"
        if installer.is_file():
            proc = subprocess.run([str(installer), "--yes"], capture_output=True, text=True)
            replanted = [l for l in proc.stdout.splitlines() if "hard rules" in l and "CHANGED" in l]
            print(f"replanted   {len(replanted)} runtime file(s)" if replanted
                  else "installer   no changes needed")

    proc = subprocess.run([new_kb, "check"], capture_output=True, text=True)
    findings = [l for l in proc.stdout.splitlines() if l and not l.startswith("kb check:")]
    errors = [l for l in findings if not l.startswith("WARN ")]
    warnings = [l for l in findings if l.startswith("WARN ")]
    if not findings:
        print("kb check    clean")
    elif errors:
        print(f"kb check    {len(errors)} finding(s), {len(warnings)} warning(s) — "
              f"a migration list, not an upgrade failure:")
    else:
        print(f"kb check    clean, {len(warnings)} warning(s) to look at:")
    for line in findings:
        print(f"  {line}")
    if errors:
        print("            re-anchor sources, re-verify or downgrade claims; see UPGRADING.md")
    return 1 if (args.strict and proc.returncode != 0) else 0


# ---------------------------------------------------------------- discover / ingest
# Both commands emit entries that pass `kb check` unchanged: status tentative,
# tags filtered against the config vocabulary (KB002), sources cited as
# path:line for files that actually exist (KB003), no template residue (KB005),
# and the required sections for the target bucket (KB006/KB010).

SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv", "dist", "build",
             ".next", "target", ".mypy_cache", ".pytest_cache", ".terraform", "vendor"}
CODE_EXT = {".ts", ".tsx", ".js", ".jsx", ".py", ".go", ".rs", ".java", ".rb", ".php", ".sh"}
MAX_SCAN_FILES = 4000
MAX_READ_BYTES = 200_000
MAX_INGEST_BYTES = 1024 * 1024

PROJECT_MARKERS = [("package.json", "nodejs"), ("tsconfig.json", "typescript"),
                   ("Cargo.toml", "rust"), ("go.mod", "go"), ("requirements.txt", "python"),
                   ("pyproject.toml", "python"), ("setup.py", "python"), ("Gemfile", "ruby"),
                   ("pom.xml", "java"), ("build.gradle", "java"), ("composer.json", "php"),
                   ("Dockerfile", "docker")]

ENTRY_POINT_NAMES = ["index.ts", "index.js", "main.ts", "main.js", "app.ts", "app.js",
                     "server.ts", "server.js", "src/index.ts", "src/main.ts", "src/app.ts",
                     "main.py", "app.py", "__main__.py", "src/main.py", "main.go", "cmd/main.go"]

ROUTE_RE = re.compile(r"(?:app|router)\.(?:get|post|put|delete|patch|use)\s*\(|"
                      r"@(?:app|router)\.(?:get|post|put|delete|route)|"
                      r"(?:HandleFunc|http\.Handle)\s*\(")
MODEL_RE = re.compile(r"^(?:export\s+)?(?:interface|type)\s+[A-Z]|^class\s+[A-Z].*:|"
                      r"^type\s+[A-Z]\w*\s+struct", re.MULTILINE)
INTEGRATION_PATTERNS = [
    ("Database (ORM/driver)", re.compile(r"mongoose|sequelize|typeorm|prisma|knex|psycopg|sqlalchemy|"
                                        r"\bpg\b|mysql|sqlite")),
    ("Redis", re.compile(r"\bioredis\b|\bredis\b")),
    ("Message queue", re.compile(r"amqp|rabbitmq|kafka|\bbull\b|\bsqs\b")),
    ("External HTTP APIs", re.compile(r"axios|\bgot\b|httpClient|requests\.get|fetch\(")),
    ("AWS services", re.compile(r"aws-sdk|@aws-sdk|boto3")),
]
CONFIG_RE = re.compile(r"(\.config\.[^/]+|^\.env.*|^config\.[^/]+|^settings\.[^/]+|"
                       r"\.ya?ml|\.toml)$")


def _walk(root, skip=()):
    """(relative path, absolute path) for every file under root, pruned and capped."""
    count = 0
    skip = {Path(s).resolve() for s in skip}
    for dirpath, dirnames, filenames in os.walk(root):
        if Path(dirpath).resolve() in skip:
            dirnames[:] = []
            continue
        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS and not d.startswith("."))
        for name in sorted(filenames):
            if name.startswith("."):
                if not name.startswith(".env"):
                    continue
            abs_path = Path(dirpath) / name
            yield str(abs_path.relative_to(root)), abs_path
            count += 1
            if count >= MAX_SCAN_FILES:
                return


def _read_head(path):
    try:
        with path.open("rb") as fh:
            return fh.read(MAX_READ_BYTES).decode("utf-8", "replace")
    except OSError:
        return ""


def scan_dir(target, skip=()):
    """Heuristic map of a directory: type, size, structure, entry points, hot spots.

    The KB folder itself is skipped: scanning your own memory back into an
    exploration entry is noise, not discovery.
    """
    files = list(_walk(target, skip))
    types = sorted({label for marker, label in PROJECT_MARKERS if (target / marker).is_file()})
    code = [(rel, abs_p) for rel, abs_p in files if abs_p.suffix in CODE_EXT]
    lines = 0
    routes, models, services, configs = [], [], [], []
    integrations = set()
    for rel, abs_p in code:
        text = _read_head(abs_p)
        lines += text.count("\n") + 1 if text else 0
        if ROUTE_RE.search(text):
            routes.append(rel)
        if MODEL_RE.search(text):
            models.append(rel)
        if "service" in rel.lower():
            services.append(rel)
        for label, pattern in INTEGRATION_PATTERNS:
            if pattern.search(text):
                integrations.add(label)
    for rel, abs_p in files:
        if CONFIG_RE.search(abs_p.name) and rel.count("/") <= 2:
            configs.append(rel)
    entry_points = [name for name in ENTRY_POINT_NAMES if (target / name).is_file()]
    dirs = sorted({rel.split("/")[0] for rel, _ in files if "/" in rel})
    return {
        "types": types or ["unknown"],
        "files": len(code),
        "lines": lines,
        "dirs": dirs[:30],
        "entry_points": entry_points[:10],
        "routes": sorted(routes)[:10],
        "models": sorted(models)[:10],
        "services": sorted(dict.fromkeys(services))[:10],
        "configs": sorted(configs)[:15],
        "integrations": sorted(integrations),
    }


def _bullets(items, empty="- none detected"):
    return "\n".join(f"- `{i}`" for i in items) if items else empty


def allowed_tags(config, wanted):
    """Keep only tags the config vocabulary declares (KB002 is a closed enum)."""
    vocab = config.get("tags", {})
    keep = []
    for tag in wanted:
        if ":" not in tag:
            continue
        dim, value = tag.split(":", 1)
        if value in vocab.get(dim, []):
            keep.append(tag)
    return keep


def _unique_path(directory, date_str, slug):
    path = directory / f"{date_str}-{slug}.md"
    n = 2
    while path.exists():
        path = directory / f"{date_str}-{slug}-{n}.md"
        n += 1
    return path


def _front_matter(title, entry_type, date_str, tags, sources):
    out = ['---', f'title: "{title}"', f"type: {entry_type}", "status: tentative",
           f"date: {date_str}"]
    out.append("tags: [" + ", ".join(tags) + "]")
    if sources:
        out.append("sources:")
        out.extend(f"  - {s}" for s in sources)
    else:
        out.append("sources: []")
    out.append("---")
    return "\n".join(out) + "\n"


def cmd_discover(kb_dir, repo_root, config, args):
    target = Path(args.target).resolve()  # os.walk only; no heavy imports needed
    if not target.is_dir():
        fail(f"not a directory: {args.target}")
    scan = scan_dir(target, skip=[kb_dir])
    focus = args.focus

    print(f"kb discover: {target}")
    print(f"  project type   {', '.join(scan['types'])}")
    print(f"  code files     {scan['files']} ({scan['lines']} lines)")
    print(f"  top-level dirs {', '.join(scan['dirs']) or '(flat)'}")
    aspects = [("entry points", "entry_points"), ("routes", "routes"), ("models", "models"),
               ("services", "services"), ("config", "configs"), ("integrations", "integrations")]
    if focus:
        aspects = [(label, key) for label, key in aspects if key in (focus, focus + "s")]
    for label, key in aspects:
        print(f"  {label:14} {', '.join(scan[key]) or '(none detected)'}")
    if args.summary:
        return 0

    # Cite entry points as real grounding; only paths inside repo_root can be sources.
    sources = []
    for name in scan["entry_points"][:5]:
        candidate = target / name
        try:
            sources.append(f"{candidate.relative_to(repo_root)}:1")
        except ValueError:
            break

    date_str = date.today().isoformat()
    slug = re.sub(r"[^a-z0-9]+", "-", target.name.lower()).strip("-") or "scan"
    slug = f"{slug}-boundaries"
    bucket_dir = Path(args.output).resolve() if args.output else kb_dir / "explorations"
    path = _unique_path(bucket_dir, date_str, slug)
    tags = allowed_tags(config, ["area:infra", "area:tooling"])[:1]
    body = f"""
## Summary

Automated boundary scan of `{target.name}` ({', '.join(scan['types'])};
{scan['files']} code files, {scan['lines']} lines). Tentative until a human confirms it.

## Context / Question

What are the boundaries of `{target.name}` — entry points, routes, models, services,
configuration and outbound integrations?

## Findings / What We Did

### Top-level structure

{_bullets(scan['dirs'], '- (flat directory)')}

### Entry points

{_bullets(scan['entry_points'])}

### Route definitions

{_bullets(scan['routes'])}

### Data models / types

{_bullets(scan['models'])}

### Services / business logic

{_bullets(scan['services'])}

### Configuration

{_bullets(scan['configs'])}

### External integrations

{_bullets(scan['integrations'])}

## Verification

Not verified: this entry is a machine scan, so it stays `tentative` until someone
confirms the boundaries and adds `path:Lstart-Lend` citations for the claims that
matter. Re-run `{kb_dir.name}/bin/kb discover {args.target}` to refresh it.
"""
    content = _front_matter(f"{target.name} codebase boundaries", "exploration",
                            date_str, tags, sources) + body
    if args.dry_run:
        print()
        print(content, end="")
        return 0
    bucket_dir.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    cmd_index(kb_dir, repo_root, config, _IndexArgs)
    print(path if not str(path).startswith(str(repo_root)) else path.relative_to(repo_root))
    return 0


BUCKET_SIGNALS = {
    "errors": [(re.compile(r"TypeError|SyntaxError|ReferenceError|Traceback|Cannot read|"
                           r"null pointer|panic:", re.I), 5),
               (re.compile(r"\bat .+:\d+:\d+", re.I), 3),
               (re.compile(r"error|exception|stack trace|failed|crash|\bbug\b|\bfix\b", re.I), 3)],
    "explorations": [(re.compile(r"how does|what is|where is|understand|investigate|explore|"
                                 r"found that|discovered", re.I), 3),
                     (re.compile(r"works by|flow is|architecture|structure|pattern", re.I), 2)],
    "solutions": [(re.compile(r"implemented|built|created|added|refactored|shipped", re.I), 3),
                  (re.compile(r"feature|functionality|component|module", re.I), 2)],
    "decisions": [(re.compile(r"decided|chose|selected|picked|went with|trade-?off|alternative|"
                              r"\bvs\.?\b|versus", re.I), 4),
                  (re.compile(r"pro:|con:|advantage|disadvantage|because|rationale", re.I), 2)],
}

TAG_SIGNALS = [
    ("area:auth", re.compile(r"\bauth\b|login|session|jwt|token|permission", re.I)),
    ("area:api", re.compile(r"\bapi\b|endpoint|route|request|response|http", re.I)),
    ("area:db", re.compile(r"database|\bdb\b|query|\bsql\b|postgres|mongo|redis", re.I)),
    ("area:ui", re.compile(r"\bui\b|component|react|vue|button|form|modal", re.I)),
    ("area:test", re.compile(r"\btest\b|spec|jest|vitest|pytest|unittest", re.I)),
    ("layer:controller", re.compile(r"controller|handler", re.I)),
    ("layer:service", re.compile(r"service|business logic|domain", re.I)),
    ("layer:model", re.compile(r"\bmodel\b|schema|entity", re.I)),
    ("layer:middleware", re.compile(r"middleware|interceptor|filter", re.I)),
]

SOURCE_CANDIDATE_RE = re.compile(r"[\w./-]+\.(?:ts|tsx|js|jsx|py|go|rs|java|rb|sh|md|json|ya?ml)"
                                 r"(?::\d+(?:-\d+)?)?")


def detect_bucket(text, config):
    scores = {}
    for bucket, signals in BUCKET_SIGNALS.items():
        if bucket not in config.get("buckets", {}):
            continue
        scores[bucket] = sum(weight for pattern, weight in signals if pattern.search(text))
    if not scores:
        return next(iter(config.get("buckets", {"explorations": ""})))
    best = max(scores.values())
    if best == 0:
        return "explorations" if "explorations" in scores else next(iter(scores))
    # Deterministic tie-break: declaration order in the config.
    for bucket in config.get("buckets", {}):
        if scores.get(bucket) == best:
            return bucket
    return "explorations"


def ingest_sources(text, repo_root):
    found = []
    for raw in SOURCE_CANDIDATE_RE.findall(text):
        path_part, _, line_part = raw.partition(":")
        candidate = (repo_root / path_part).resolve()
        try:
            candidate.relative_to(repo_root)
        except ValueError:
            continue
        if not candidate.is_file():
            continue
        rel = str(candidate.relative_to(repo_root))
        entry = f"{rel}:{line_part}" if line_part else f"{rel}:1"
        if entry not in found:
            found.append(entry)
        if len(found) == 5:
            break
    return found


def cmd_ingest(kb_dir, repo_root, config, args):
    if args.input:
        source_file = Path(args.input)
        if not source_file.is_file():
            fail(f"input file not found: {args.input}")
        raw = source_file.read_bytes()[:MAX_INGEST_BYTES].decode("utf-8", "replace")
    else:
        if sys.stdin.isatty():
            print("kb ingest: reading from stdin (paste, then Ctrl-D)", file=sys.stderr)
        raw = sys.stdin.read(MAX_INGEST_BYTES)
    text = raw.strip()
    if not text:
        fail("no content provided (pass --input FILE or pipe text in)")

    types = {bucket: t for t, bucket in config.get("types", {}).items()}
    bucket = args.bucket or detect_bucket(text, config)
    if bucket not in config.get("buckets", {}):
        fail(f"unknown bucket '{bucket}' (declared: {', '.join(config.get('buckets', {}))})")
    entry_type = types.get(bucket, bucket.rstrip("s"))

    title = args.title
    if not title:
        heading = next((l.lstrip("# ").strip() for l in text.split("\n") if l.startswith("#")), "")
        first = next((l.strip() for l in text.split("\n") if l.strip()), "Untitled")
        title = (heading or first)[:70]
    title = title.replace('"', "'").replace("\n", " ").strip()
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].strip("-") or "untitled"
    tags = allowed_tags(config, [tag for tag, pattern in TAG_SIGNALS if pattern.search(text)])[:5]
    sources = ingest_sources(text, repo_root)
    summary = " ".join(l.strip() for l in text.split("\n") if len(l.strip()) > 30)[:280]

    date_str = date.today().isoformat()
    path = _unique_path(kb_dir / bucket, date_str, slug)
    error_sections = ERROR_SECTIONS if bucket == "errors" else ""
    # The ingested text is fenced: a transcript containing its own "## " headings
    # would otherwise collide with the entry's sections (KB006/KB010).
    body = f"""
## Summary

{summary or '<!-- 1-2 sentences: the key takeaway -->'}

## Context / Question

Ingested from {'`' + args.input + '`' if args.input else 'piped input'} on {date_str};
draft, not yet reviewed.

## Findings / What We Did

Review and rewrite as conclusions, then cite `path:Lstart-Lend` for each claim.

```
{text}
```
{error_sections}
## Verification

Not verified: ingested text is a claim, not proof. Stays `tentative` until the
claims are checked against the sources and captured output is pasted here.
"""
    content = _front_matter(title, entry_type, date_str, tags, sources) + body
    print(f"kb ingest: bucket {bucket}/  title {title!r}  tags [{', '.join(tags)}]", file=sys.stderr)
    if args.dry_run:
        print(f"would create: {path.relative_to(repo_root) if str(path).startswith(str(repo_root)) else path}")
        print()
        print(content, end="")
        return 0
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    cmd_index(kb_dir, repo_root, config, _IndexArgs)
    print(path.relative_to(repo_root) if str(path).startswith(str(repo_root)) else path)
    return 0


class _IndexArgs:
    stdout = False


class _CheckArgs:
    json = False
    staged = False
    diff_base = None
    repo = None


def cmd_stop_hook(kb_dir, repo_root, config, args):
    import contextlib
    import io
    """Loop-safe wrapper for the agent Stop / SubagentStop hook.

    Exit 2 makes Claude Code hand the hook's stderr back to the model and keep
    working instead of stopping. While that continuation is in flight the hook
    payload carries stop_hook_active: true — blocking again on the same finding
    would loop forever, so the second pass reports without blocking.
    """
    payload = {}
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
        if raw.strip():
            try:
                loaded = json.loads(raw)
                payload = loaded if isinstance(loaded, dict) else {}
            except json.JSONDecodeError:
                payload = {}
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        code = cmd_check(kb_dir, repo_root, config, _CheckArgs)
    report = buf.getvalue().rstrip()
    if code == 0:
        return 0
    if payload.get("stop_hook_active"):
        print(report, file=sys.stderr)
        print("kb: still not clean, but the stop hook already ran once — not blocking again.",
              file=sys.stderr)
        return 0
    print(report, file=sys.stderr)
    print(f"kb: the knowledge base is not clean. Record the work "
          f"(`{kb_dir.name}/bin/kb new <type> <slug>`), run `{kb_dir.name}/bin/kb index`, "
          f"then finish.", file=sys.stderr)
    return 2


def cmd_index(kb_dir, repo_root, config, args):
    findings = []
    entries = collect_entries(kb_dir, config, findings)
    fronts = []
    today = date.today()
    scratch = []
    for bucket, path in entries:
        fronts.append(check_entry(kb_dir, repo_root, config, bucket, path, scratch, today))
    generated = generate_index(kb_dir, repo_root, config, fronts)
    if args.stdout:
        print(generated, end="")
    else:
        (kb_dir / "INDEX.md").write_text(generated, encoding="utf-8")
        html = generate_html(kb_dir, repo_root, config, entries, generated)
        (kb_dir / "INDEX.html").write_text(html, encoding="utf-8")
        write_digest(kb_dir, config)   # keeps `kb find` at one file read
        print(f"regenerated {kb_dir / 'INDEX.md'} and INDEX.html", file=sys.stderr)
    return 0


NEW_BODY = """
## Summary

<!-- 1-2 sentences: the key takeaway -->

## Context / Question

<!-- What triggered this investigation/work? -->

## Findings / What We Did

<!-- Cite a source for EVERY claim (path:Lstart-Lend). Unsourced = stays tentative. -->
{error_sections}
## Verification

<!-- Required before status: verified (KB004). Paste ACTUAL command + captured output
     in a fenced block. Hypothetical markers (# should / # expected / # todo) are rejected. -->
"""

ERROR_SECTIONS = """
## Symptom

<!-- Exact error message / observed behavior. ONE trap per entry (KB010). -->

## Root Cause

<!-- Why? Cite source files. -->

## Fix

<!-- What changed? File paths + code. -->

## Prevention

<!-- How to avoid re-introducing it. -->
"""


def cmd_new(kb_dir, repo_root, config, args):
    types = config.get("types", {})
    if args.type not in types:
        fail(f"unknown type '{args.type}' (declared: {', '.join(types)})")
    slug = args.slug.strip().lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", slug):
        fail(f"slug must be kebab-case: {args.slug!r}")
    today = date.today().isoformat()
    bucket = types[args.type]
    path = kb_dir / bucket / f"{today}-{slug}.md"
    if path.exists():
        fail(f"already exists: {path}")
    title = slug.replace("-", " ").capitalize()
    body = NEW_BODY.format(error_sections=ERROR_SECTIONS if bucket == "errors" else "")
    front = (f"---\n"
             f"title: {title}\n"
             f"type: {args.type}\n"
             f"status: tentative\n"
             f"date: {today}\n"
             f"tags: []\n"
             f"sources: []\n"
             f"---\n")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(front + body, encoding="utf-8")

    class _A:
        stdout = False
    cmd_index(kb_dir, repo_root, config, _A)
    print(path.relative_to(repo_root))
    return 0


def main():
    parser = argparse.ArgumentParser(prog="kb", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--kb-dir", help="KB directory (default: parent of this script)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_new = sub.add_parser("new", help="scaffold a valid entry")
    p_new.add_argument("type")
    p_new.add_argument("slug")

    p_index = sub.add_parser("index", help="regenerate INDEX.md from front-matter")
    p_index.add_argument("--stdout", action="store_true", help="print instead of writing")

    p_check = sub.add_parser("check", help="validate the KB")
    p_check.add_argument("--json", action="store_true", help="machine-readable report")
    p_check.add_argument("--staged", action="store_true", help="also run diff rules against staged changes")
    p_check.add_argument("--diff-base", help="also run diff rules against <ref>...HEAD")
    p_check.add_argument("--repo", help="compute the diff in this repository instead of the KB's "
                                        "parent (context workspace: KB above a nested app repo)")

    p_rules = sub.add_parser("rules", help="print agent hard-rules block (for prompt-injection hooks)")
    p_rules.add_argument("--plant", action="store_true",
                         help="print the marker-wrapped HARD RULE block install.sh plants")
    p_rules.add_argument("--targets", action="store_true",
                         help="print the runtime files to plant, as <path>|<kind> lines")

    p_find = sub.add_parser("find", help="search the KB; print only the hits (start here)")
    p_find.add_argument("query", help="keywords, e.g. \"rounding money cents\"")
    p_find.add_argument("-n", "--limit", type=int, default=5, help="max hits (default 5)")
    p_find.add_argument("--full", action="store_true", help="print whole entries, not just hits")
    p_find.add_argument("--deep", action="store_true",
                        help="also scan entry bodies (automatic when the index finds nothing)")
    p_find.add_argument("-s", "--show", action="store_true",
                        help="also print the top hit's actionable core (one call instead of two)")
    p_find.add_argument("--lines", type=int, default=20,
                        help="with --show, max lines per section (default 20)")

    p_show = sub.add_parser("show", help="print one entry's actionable core")
    p_show.add_argument("entry", help="bucket/file.md, a filename, or a slug fragment")
    p_show.add_argument("--all", action="store_true", help="print the entry verbatim")
    p_show.add_argument("--lines", type=int, default=20, help="max lines per section (default 20)")

    p_disc = sub.add_parser("discover", help="scan a directory into a tentative exploration entry")
    p_disc.add_argument("target", help="directory to scan")
    p_disc.add_argument("-s", "--summary", action="store_true", help="print the scan only, write nothing")
    p_disc.add_argument("-d", "--dry-run", action="store_true", help="show the entry, write nothing")
    p_disc.add_argument("-o", "--output", help="bucket directory for the entry "
                                               "(default: <kb>/explorations)")
    p_disc.add_argument("-f", "--focus", choices=["routes", "models", "services", "config"],
                        help="report a single aspect")

    p_ing = sub.add_parser("ingest", help="turn a document or transcript into a draft entry")
    p_ing.add_argument("-i", "--input", help="input file (default: stdin)")
    p_ing.add_argument("-b", "--bucket", help="target bucket (default: auto-detect)")
    p_ing.add_argument("-a", "--auto", action="store_true", help="auto-detect the bucket (default)")
    p_ing.add_argument("-t", "--title", help="entry title (default: derived from the text)")
    p_ing.add_argument("-d", "--dry-run", action="store_true", help="show the entry, write nothing")

    sub.add_parser("stop-hook", help="loop-safe `kb check` for agent Stop/SubagentStop hooks")

    p_up = sub.add_parser("upgrade", help="vendor a newer tool version (tooling only)")
    p_up.add_argument("--dry-run", action="store_true", help="report what would change, change nothing")
    p_up.add_argument("--source", help="path to a knowledge-database checkout to upgrade from")
    p_up.add_argument("--no-network", action="store_true", help="never clone; local sources only")
    p_up.add_argument("--no-install", action="store_true", help="skip the install.sh rerun (no replant)")
    p_up.add_argument("--force", action="store_true", help="re-vendor even if not newer")
    p_up.add_argument("--strict", action="store_true", help="exit non-zero if `kb check` has findings")

    p_ver = sub.add_parser("version", help="print tool version, config kb_version, available update")
    p_ver.add_argument("--check", action="store_true",
                       help="probe upstream for a newer version (may clone) and cache the answer")

    args = parser.parse_args()
    kb_dir = find_kb_dir(args.kb_dir)
    repo_root = kb_dir.parent
    config = load_config(kb_dir)

    if args.cmd == "new":
        return cmd_new(kb_dir, repo_root, config, args)
    if args.cmd == "index":
        return cmd_index(kb_dir, repo_root, config, args)
    if args.cmd == "check":
        return cmd_check(kb_dir, repo_root, config, args)
    if args.cmd == "rules":
        return cmd_rules(kb_dir, repo_root, config, args)
    if args.cmd == "find":
        return cmd_find(kb_dir, repo_root, config, args)
    if args.cmd == "show":
        return cmd_show(kb_dir, repo_root, config, args)
    if args.cmd == "discover":
        return cmd_discover(kb_dir, repo_root, config, args)
    if args.cmd == "ingest":
        return cmd_ingest(kb_dir, repo_root, config, args)
    if args.cmd == "stop-hook":
        return cmd_stop_hook(kb_dir, repo_root, config, args)
    if args.cmd == "upgrade":
        return cmd_upgrade(kb_dir, repo_root, config, args)
    if args.cmd == "version":
        return cmd_version(kb_dir, repo_root, config, args)
    return 2


if __name__ == "__main__":
    sys.exit(main())
