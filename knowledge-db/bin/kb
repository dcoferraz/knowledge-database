#!/usr/bin/env python3
"""kb — zero-dependency knowledge-db CLI.

Subcommands:
  kb new <type> <slug>      Scaffold a valid entry (status: tentative), regenerate INDEX.md/.html
  kb index                  Regenerate INDEX.md + INDEX.html entirely from entry front-matter
  kb check                  Validate the KB; exit non-zero with "RULE_ID file: message" lines
  kb rules                  Print the agent hard-rules block (for prompt-injection hooks)

Rules (each implemented in `check`, each with a fixture in tests/fixtures/):
  KB001  entry path/front-matter shape       KB007  INDEX.md matches generated output
  KB002  closed vocabularies (config)        KB008  verified entries go stale
  KB003  sources grammar + existence         KB009  lockstep pairs (diff mode)
  KB004  verified requires captured proof    KB010  one trap per error entry
  KB005  superseded links replacement;       KB011  write-back trigger (diff mode)
         no template residue                 KB012  INDEX.html fresh (fingerprint)
  KB006  required sections per bucket        KB013  doc write-back trigger (diff mode)

Python 3 stdlib only. No YAML dependency: parses the flat front-matter schema
documented in README.md (scalar keys, inline [a, b] lists, block "- item" lists).
"""

import argparse
import hashlib
import json
import re
import subprocess
import sys
from datetime import date, datetime, timedelta
from pathlib import Path

MANUAL_START = "<!-- kb:manual:{name}:start -->"
MANUAL_END = "<!-- kb:manual:{name}:end -->"

KNOWN_ROOT_FILES = {"README.md", "INDEX.md", "INDEX.html", "_TEMPLATE.md", "AGENT.md",
                    "kb.config.json", "install.sh"}
KNOWN_ROOT_DIRS = {"bin"}
REQUIRED_KEYS = ["title", "type", "status", "date", "tags", "sources"]
OPTIONAL_KEYS = ["related", "last_verified", "decision_by"]
SOURCE_RE = re.compile(r"^(?P<path>[^:\s][^:]*):(?P<start>\d+)(-(?P<end>\d+))?(@(?P<rev>[0-9a-fA-F]{6,40}))?$")
FILENAME_RE = re.compile(r"^(?P<date>\d{4}-\d{2}-\d{2})-(?P<slug>[a-z0-9][a-z0-9-]*)\.md$")
HYPOTHETICAL_RE = re.compile(r"^\s*#\s*(should|todo|expected|works)\b", re.IGNORECASE)


class Finding:
    def __init__(self, rule, file, message, warning=False):
        self.rule = rule
        self.file = file
        self.message = message
        self.warning = warning

    def line(self):
        prefix = "WARN " if self.warning else ""
        return f"{prefix}{self.rule} {self.file}: {self.message}"


def fail(msg):
    print(f"kb: {msg}", file=sys.stderr)
    sys.exit(2)


def find_kb_dir(cli_kb_dir):
    if cli_kb_dir:
        kb = Path(cli_kb_dir).resolve()
        if not (kb / "kb.config.json").is_file():
            fail(f"no kb.config.json in {kb}")
        return kb
    here = Path(__file__).resolve().parent.parent
    if (here / "kb.config.json").is_file():
        return here
    fail("cannot locate kb.config.json (pass --kb-dir)")


def load_config(kb_dir):
    try:
        return json.loads((kb_dir / "kb.config.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e:
        fail(f"kb.config.json unreadable: {e}")


# ---------------------------------------------------------------- parsing

def _strip_comment(value):
    # Strip a trailing "  # comment" outside quotes.
    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
        return value[1:-1]
    m = re.search(r"\s+#", value)
    if m:
        value = value[: m.start()]
    value = value.strip()
    if value.startswith('"') and value.endswith('"') and len(value) >= 2:
        value = value[1:-1]
    return value


def parse_entry(path):
    """Return dict: front (key -> str|list), sections {name: text}, errors [str],
    residue (bool: bare '-' list items present), order (section names in order)."""
    text = path.read_text(encoding="utf-8")
    lines = text.split("\n")
    result = {"front": {}, "sections": {}, "section_counts": {}, "errors": [], "residue": False}
    if not lines or lines[0].strip() != "---":
        result["errors"].append("missing front-matter (file must start with ---)")
        return result
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        result["errors"].append("unterminated front-matter (no closing ---)")
        return result

    front = result["front"]
    current_list_key = None
    for raw in lines[1:end]:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        m = re.match(r"^([A-Za-z_][A-Za-z0-9_]*):(.*)$", raw)
        if m:
            key, rest = m.group(1), m.group(2).strip()
            if rest == "" or rest.startswith("#"):
                front[key] = []
                current_list_key = key
            elif rest.startswith("[") and rest.endswith("]"):
                inner = rest[1:-1].strip()
                front[key] = [v.strip() for v in inner.split(",") if v.strip()] if inner else []
                current_list_key = None
            else:
                front[key] = _strip_comment(rest)
                current_list_key = None
        elif re.match(r"^\s+-", raw):
            item = _strip_comment(re.sub(r"^\s+-\s*", "", raw))
            if current_list_key is None:
                result["errors"].append(f"stray list item: {raw.strip()!r}")
                continue
            if item == "":
                result["residue"] = True
            else:
                front[current_list_key].append(item)
        else:
            result["errors"].append(f"unparseable front-matter line: {raw.strip()!r}")

    # sections
    body = lines[end + 1:]
    current = None
    for raw in body:
        h = re.match(r"^##\s+(.+?)\s*$", raw)
        if h:
            current = h.group(1)
            result["section_counts"][current] = result["section_counts"].get(current, 0) + 1
            result["sections"].setdefault(current, "")
            continue
        if current is not None:
            result["sections"][current] += raw + "\n"
    return result


def fenced_blocks(section_text):
    blocks, in_fence, buf = [], False, []
    for raw in section_text.split("\n"):
        if raw.strip().startswith("```"):
            if in_fence:
                blocks.append("\n".join(buf))
                buf = []
            in_fence = not in_fence
            continue
        if in_fence:
            buf.append(raw)
    return blocks


# ---------------------------------------------------------------- glob

def glob_match(pattern, path):
    """Match path against a glob where ** crosses '/' and * does not.
    A pattern ending in '/' matches any path under that prefix."""
    if pattern.endswith("/"):
        return path.startswith(pattern) or path + "/" == pattern
    regex = ""
    i = 0
    while i < len(pattern):
        c = pattern[i]
        if c == "*":
            if pattern[i:i + 2] == "**":
                regex += ".*"
                i += 2
                if i < len(pattern) and pattern[i] == "/":
                    i += 1
                continue
            regex += "[^/]*"
        elif c == "?":
            regex += "[^/]"
        else:
            regex += re.escape(c)
        i += 1
    return re.fullmatch(regex, path) is not None


# ---------------------------------------------------------------- entries

def collect_entries(kb_dir, config, findings):
    buckets = set(config.get("buckets", {}))
    entries = []
    for child in sorted(kb_dir.iterdir()):
        name = child.name
        if name.startswith("."):
            continue
        if child.is_dir():
            if name in KNOWN_ROOT_DIRS:
                continue
            if name not in buckets:
                findings.append(Finding("KB002", f"{kb_dir.name}/{name}/",
                                        f"unknown bucket directory (declare in kb.config.json buckets or remove)"))
                continue
            for f in sorted(child.iterdir()):
                if f.name.startswith(".") or f.is_dir():
                    continue
                if f.suffix != ".md":
                    findings.append(Finding("KB001", f"{kb_dir.name}/{name}/{f.name}",
                                            "non-markdown file in bucket"))
                    continue
                entries.append((name, f))
        elif name not in KNOWN_ROOT_FILES:
            findings.append(Finding("KB002", f"{kb_dir.name}/{name}",
                                    "unknown file at KB root (not a declared artifact)"))
    return entries


def check_entry(kb_dir, repo_root, config, bucket, path, findings, today):
    rel = str(path.relative_to(repo_root))
    parsed = parse_entry(path)
    for e in parsed["errors"]:
        findings.append(Finding("KB001", rel, e))
    front = parsed["front"]

    # KB001: filename shape, required keys, type<->dir, filename date == date
    m = FILENAME_RE.match(path.name)
    if not m:
        findings.append(Finding("KB001", rel, "filename must be YYYY-MM-DD-<kebab-slug>.md"))
    for key in REQUIRED_KEYS:
        if key not in front:
            findings.append(Finding("KB001", rel, f"missing front-matter key: {key}"))
    for key in front:
        if key not in REQUIRED_KEYS and key not in OPTIONAL_KEYS:
            findings.append(Finding("KB001", rel, f"unknown front-matter key: {key}", warning=True))
    entry_type = front.get("type", "")
    types = config.get("types", {})
    if isinstance(entry_type, str) and entry_type in types and types[entry_type] != bucket:
        findings.append(Finding("KB001", rel, f"type '{entry_type}' belongs in {types[entry_type]}/, found in {bucket}/"))
    entry_date = front.get("date", "")
    parsed_date = None
    if isinstance(entry_date, str) and entry_date:
        try:
            parsed_date = datetime.strptime(entry_date, "%Y-%m-%d").date()
        except ValueError:
            findings.append(Finding("KB001", rel, f"date '{entry_date}' is not a valid YYYY-MM-DD date"))
        if m and parsed_date and m.group("date") != entry_date:
            findings.append(Finding("KB001", rel, f"filename date {m.group('date')} != front-matter date {entry_date}"))

    # KB002: closed vocabularies
    if isinstance(entry_type, str) and entry_type and entry_type not in types:
        findings.append(Finding("KB002", rel, f"type '{entry_type}' not declared in kb.config.json types"))
    status = front.get("status", "")
    if isinstance(status, str) and status and status not in config.get("statuses", []):
        findings.append(Finding("KB002", rel, f"status '{status}' not declared in kb.config.json statuses"))
    tag_vocab = config.get("tags", {})
    for tag in front.get("tags", []) if isinstance(front.get("tags"), list) else []:
        if ":" not in tag:
            findings.append(Finding("KB002", rel, f"tag '{tag}' must be <dimension>:<value>"))
            continue
        dim, value = tag.split(":", 1)
        if dim not in tag_vocab:
            findings.append(Finding("KB002", rel, f"tag dimension '{dim}' not declared in kb.config.json tags"))
        elif value not in tag_vocab[dim]:
            findings.append(Finding("KB002", rel, f"tag '{tag}' not declared in kb.config.json tags.{dim}"))

    # KB003: sources grammar + existence (+ rev-drift warning)
    sources = front.get("sources", [])
    if isinstance(sources, list):
        for src in sources:
            sm = SOURCE_RE.match(src)
            if not sm:
                findings.append(Finding("KB003", rel,
                                        f"source '{src}' must match path:Lstart[-Lend][@rev] (bare paths rejected)"))
                continue
            src_path = repo_root / sm.group("path")
            if not src_path.is_file():
                findings.append(Finding("KB003", rel, f"source path not found: {sm.group('path')}"))
            elif sm.group("rev"):
                drift = git_lines(repo_root, ["diff", "--name-only", sm.group("rev"), "--", sm.group("path")])
                if drift is None:
                    findings.append(Finding("KB003", rel,
                                            f"source rev @{sm.group('rev')} not resolvable in git", warning=True))
                elif drift:
                    findings.append(Finding("KB003", rel,
                                            f"{sm.group('path')} changed since @{sm.group('rev')}; re-check line range",
                                            warning=True))
        if status == "verified" and not sources:
            findings.append(Finding("KB003", rel, "verified entry must cite at least one source"))

    # KB004: verified requires captured proof
    if status == "verified":
        verif = parsed["sections"].get("Verification")
        if verif is None:
            findings.append(Finding("KB004", rel, "status verified but no '## Verification' section"))
        else:
            blocks = fenced_blocks(verif)
            nonempty = [b for b in blocks if b.strip()]
            if not nonempty:
                findings.append(Finding("KB004", rel,
                                        "Verification must contain a fenced block with captured output"))
            for b in nonempty:
                for line in b.split("\n"):
                    if HYPOTHETICAL_RE.match(line):
                        findings.append(Finding("KB004", rel,
                                                f"hypothetical-output marker in Verification: {line.strip()!r}"))

    # KB005: superseded links replacement; no template residue
    related = front.get("related", [])
    if status == "superseded" and (not isinstance(related, list) or not related):
        findings.append(Finding("KB005", rel, "status superseded requires non-empty related: linking the replacement"))
    if parsed["residue"]:
        findings.append(Finding("KB005", rel, "template residue: bare '-' under a list key"))

    # KB006: required sections per bucket
    for section in config.get("required_sections", {}).get(bucket, []):
        if section not in parsed["sections"]:
            findings.append(Finding("KB006", rel, f"missing required section: ## {section}"))

    # KB008: verified entries go stale
    budget = config.get("staleness_days", {}).get("verified")
    if status == "verified" and budget and parsed_date:
        last = parsed_date
        lv = front.get("last_verified")
        if isinstance(lv, str) and lv:
            try:
                last = datetime.strptime(lv, "%Y-%m-%d").date()
            except ValueError:
                findings.append(Finding("KB001", rel, f"last_verified '{lv}' is not a valid YYYY-MM-DD date"))
        if (today - last).days > budget:
            findings.append(Finding("KB008", rel,
                                    f"verified {(today - last).days}d ago (budget {budget}d): "
                                    "re-verify (bump last_verified with fresh proof) or downgrade to tentative"))

    # KB010: one trap per error entry
    if bucket == "errors":
        for section in ("Symptom", "Root Cause", "Fix", "Prevention"):
            if parsed["section_counts"].get(section, 0) > 1:
                findings.append(Finding("KB010", rel,
                                        f"multiple '## {section}' sections: one trap per error entry — split it"))

    front["_rel"] = f"{bucket}/{path.name}"
    return front


# ---------------------------------------------------------------- INDEX

def read_manual_region(index_text, name, default):
    start = MANUAL_START.format(name=name)
    end = MANUAL_END.format(name=name)
    if index_text and start in index_text and end in index_text:
        return index_text.split(start, 1)[1].split(end, 1)[0].strip("\n")
    return default


DEFAULT_READY = ("| Topic | Canonical Source | Last Verified |\n"
                 "|-------|------------------|---------------|")
DEFAULT_EXTERNAL = ("| Doc | Purpose | Path/URL | Last Verified |\n"
                    "|-----|---------|----------|---------------|")

BUCKET_HEADINGS = {
    "explorations": ("Explorations", '_"What is true" — findings from investigating existing behavior_'),
    "solutions": ("Solutions", '_"What we did" — how changes/features/fixes were implemented_'),
    "errors": ("Errors", '_"What broke + the fix" — reproducible traps and their resolution_'),
    "decisions": ("Decisions", '_"Why we chose X" — design/architecture choices and trade-offs_'),
}


def generate_index(kb_dir, repo_root, config, entry_fronts):
    existing = ""
    index_path = kb_dir / "INDEX.md"
    if index_path.is_file():
        existing = index_path.read_text(encoding="utf-8")
    ready = read_manual_region(existing, "ready-answers", DEFAULT_READY)
    external = read_manual_region(existing, "external-docs", DEFAULT_EXTERNAL)

    out = []
    out.append("# Knowledge Database Index")
    out.append("")
    out.append("The front door to project memory. **Search here BEFORE investigating.**")
    out.append("")
    out.append("GENERATED by `bin/kb index` from entry front-matter (rule KB007).")
    out.append("Hand-edit ONLY inside the `kb:manual` fenced regions; everything else is overwritten.")
    out.append("")
    out.append("---")
    out.append("")
    out.append("## Ready-Answer Table")
    out.append("")
    out.append("_Topic → the ONE doc to read. Check these BEFORE exploring._")
    out.append("")
    out.append(MANUAL_START.format(name="ready-answers"))
    out.append(ready)
    out.append(MANUAL_END.format(name="ready-answers"))
    out.append("")
    out.append("---")
    out.append("")
    out.append("## Lock-Step Invariants")
    out.append("")
    out.append("_Declared in `kb.config.json` (`lockstep`), enforced by KB009 in diff mode._")
    out.append("")
    out.append("| When This Changes | Must Also Update |")
    out.append("|-------------------|------------------|")
    for pair in config.get("lockstep", []):
        out.append(f"| {pair.get('source', '')} | {pair.get('doc', '')} |")
    out.append("")
    out.append("---")
    out.append("")
    out.append("## Source-of-Truth Hierarchy")
    out.append("")
    out.append("_When sources disagree, trust the higher rank. Note stale sources._")
    out.append("")
    out.append("1. **Real source assets** — Code, actual configs, runtime behavior")
    out.append("2. **Generated definitions** — ETL outputs, compiled schemas")
    out.append("3. **Outbound feeds** — API responses, exports")
    out.append("4. **Documentation** — READMEs, design docs (can drift)")
    out.append("")

    for bucket in config.get("buckets", {}):
        title, blurb = BUCKET_HEADINGS.get(bucket, (bucket.title(), f"_{config['buckets'][bucket]}_"))
        out.append("---")
        out.append("")
        out.append(f"## {title}")
        out.append("")
        out.append(blurb)
        out.append("")
        out.append("| Date | Title | Status | Tags | Entry |")
        out.append("|------|-------|--------|------|-------|")
        rows = [f for f in entry_fronts if f["_rel"].startswith(bucket + "/")]
        rows.sort(key=lambda f: (str(f.get("date", "")), f["_rel"]), reverse=True)
        for f in rows:
            tags = f.get("tags", [])
            tags_cell = "[" + ", ".join(tags) + "]" if isinstance(tags, list) and tags else ""
            out.append(f"| {f.get('date', '')} | {f.get('title', '')} | {f.get('status', '')} "
                       f"| {tags_cell} | {f['_rel']} |")
        out.append("")

    out.append("---")
    out.append("")
    out.append("## Canonical External Docs")
    out.append("")
    out.append("_External sources of truth indexed here for quick reference_")
    out.append("")
    out.append(MANUAL_START.format(name="external-docs"))
    out.append(external)
    out.append(MANUAL_END.format(name="external-docs"))
    out.append("")
    out.append("---")
    out.append("")
    out.append("## Tag Vocabulary")
    out.append("")
    out.append("_Closed enums from `kb.config.json` (rule KB002). To add a tag, edit the config._")
    out.append("")
    for dim, values in config.get("tags", {}).items():
        out.append(f"- `{dim}:` " + (", ".join(f"`{v}`" for v in values) if values else "(none declared)"))
    out.append("")
    return "\n".join(out)


# ---------------------------------------------------------------- HTML view
# INDEX.html: self-contained, human-facing evidence browser generated alongside
# INDEX.md. Inlines every entry, renders Verification proof, embeds the cited
# source lines for each `sources:` item (best-effort context, captured at build
# time), and links related/superseding entries as in-page anchors.
# Freshness is enforced by KB012 via an embedded fingerprint of the KB content
# (generated INDEX.md + entry files). Embedded code snippets are deliberately
# NOT part of the fingerprint: they depend on files outside the KB, and a
# byte-for-byte rule like KB007 would fail on every unrelated code edit.

HTML_BUCKET_LABELS = {
    "explorations": "What we know",
    "solutions": "What we built",
    "errors": "What broke + the fix",
    "decisions": "Why we chose things",
}

SNIPPET_MAX_LINES = 60


def kb_fingerprint(index_md_text, entry_pairs):
    h = hashlib.sha256()
    h.update(index_md_text.encode("utf-8"))
    for rel, content in sorted(entry_pairs):
        h.update(rel.encode("utf-8"))
        h.update(b"\x00")
        h.update(content.encode("utf-8"))
    return h.hexdigest()


def _esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _inline(s, entry_ids):
    # input must already be HTML-escaped
    s = re.sub(r"`([^`]+)`", r"<code>\1</code>", s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", s)

    def link(m):
        text, href = m.group(1), m.group(2)
        if href in entry_ids:
            return f'<a href="#{href}">{text}</a>'
        if href.startswith(("http://", "https://", "#")):
            return f'<a href="{href}">{text}</a>'
        return text  # local file links are dead in a standalone page
    return re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)", link, s)


def _md_to_html(text, entry_ids):
    out, para, fence, table, ul = [], [], None, [], False

    def flush_para():
        if para:
            out.append("<p>" + _inline(" ".join(para), entry_ids) + "</p>")
            para.clear()

    def flush_table():
        if not table:
            return
        rows = [r for r in table if not re.match(r"^\s*\|[\s\-|:]+\|\s*$", r)]
        out.append('<div class="tblwrap"><table>')
        for i, row in enumerate(rows):
            cells = [c.strip() for c in row.strip().strip("|").split("|")]
            tag = "th" if i == 0 else "td"
            out.append("<tr>" + "".join(f"<{tag}>{_inline(_esc(c), entry_ids)}</{tag}>" for c in cells) + "</tr>")
        out.append("</table></div>")
        table.clear()

    def close_ul():
        nonlocal ul
        if ul:
            out.append("</ul>")
            ul = False

    for raw in text.split("\n"):
        if fence is not None:
            if raw.strip().startswith("```"):
                out.append("<pre><code>" + _esc("\n".join(fence)) + "</code></pre>")
                fence = None
            else:
                fence.append(raw)
            continue
        if raw.strip().startswith("```"):
            flush_para(); flush_table(); close_ul()
            fence = []
            continue
        if re.match(r"^\s*\|", raw):
            flush_para(); close_ul()
            table.append(raw)
            continue
        flush_table()
        h = re.match(r"^(#{3,4})\s+(.*)$", raw)
        if h:
            flush_para(); close_ul()
            level = len(h.group(1))
            out.append(f"<h{level}>{_inline(_esc(h.group(2)), entry_ids)}</h{level}>")
            continue
        li = re.match(r"^\s*(?:[-*]|\d+[.)])\s+(.*)$", raw)
        if li:
            flush_para()
            if not ul:
                out.append("<ul>")
                ul = True
            out.append("<li>" + _inline(_esc(li.group(1)), entry_ids) + "</li>")
            continue
        if raw.strip().startswith(">"):
            flush_para(); close_ul()
            out.append("<blockquote>" + _inline(_esc(raw.strip()[1:].strip()), entry_ids) + "</blockquote>")
            continue
        if not raw.strip():
            flush_para(); close_ul()
            continue
        if raw.strip().startswith("<!--"):
            continue
        close_ul()
        para.append(_esc(raw.strip()))
    if fence is not None:
        out.append("<pre><code>" + _esc("\n".join(fence)) + "</code></pre>")
    flush_para(); flush_table(); close_ul()
    return "\n".join(out)


def _source_snippet(repo_root, src):
    m = SOURCE_RE.match(src)
    if not m:
        return None
    path = repo_root / m.group("path")
    if not path.is_file():
        return "(source file not found)"
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").split("\n")
    except OSError:
        return "(source file unreadable)"
    start = int(m.group("start"))
    end = int(m.group("end") or m.group("start"))
    end = min(end, start + SNIPPET_MAX_LINES - 1, len(lines))
    if start > len(lines):
        return "(cited lines beyond end of file)"
    sel = lines[start - 1:end]
    return "\n".join(f"{i:>5}  {l}" for i, l in enumerate(sel, start))


HTML_CSS = """
:root { --fg:#1f2328; --muted:#59636e; --line:#d1d9e0; --bg:#ffffff; --soft:#f6f8fa;
        --ok:#1a7f37; --warn:#9a6700; --gone:#59636e; --accent:#0969da; }
* { box-sizing:border-box; }
body { margin:0; font:15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
       color:var(--fg); background:var(--bg); }
header.top { position:sticky; top:0; background:var(--bg); border-bottom:1px solid var(--line);
             padding:10px 20px; display:flex; gap:12px; align-items:center; flex-wrap:wrap; z-index:2; }
header.top h1 { font-size:17px; margin:0; }
header.top input { flex:1; min-width:200px; padding:6px 10px; border:1px solid var(--line); border-radius:6px; }
header.top select { padding:6px; border:1px solid var(--line); border-radius:6px; }
.layout { display:grid; grid-template-columns:280px 1fr; gap:0; }
nav.side { border-right:1px solid var(--line); padding:14px; height:calc(100vh - 54px);
           overflow:auto; position:sticky; top:54px; }
nav.side h2 { font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); margin:16px 0 6px; }
nav.side a { display:block; padding:3px 6px; color:var(--fg); text-decoration:none; border-radius:5px; font-size:13.5px; }
nav.side a:hover { background:var(--soft); }
main { padding:20px 28px 80px; max-width:900px; }
.dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; }
.dot.verified{background:var(--ok);} .dot.tentative{background:var(--warn);} .dot.superseded{background:var(--gone);}
article.entry { border:1px solid var(--line); border-radius:10px; padding:18px 22px; margin:0 0 22px; }
article.entry.hide { display:none; }
article.entry > h2 { margin:0 0 6px; font-size:19px; }
.meta { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:10px; }
.badge { font-size:12px; padding:2px 9px; border-radius:999px; border:1px solid var(--line); color:var(--muted); }
.badge.verified { color:var(--ok); border-color:var(--ok); }
.badge.tentative { color:var(--warn); border-color:var(--warn); }
.badge.superseded { color:var(--gone); border-color:var(--gone); text-decoration:line-through; }
.banner { background:#fff8f6; border:1px solid #f0c8c0; border-radius:8px; padding:8px 12px; margin:8px 0 12px; font-size:14px; }
.proof { background:var(--soft); border:1px solid var(--line); border-radius:8px; padding:4px 14px 10px; margin:10px 0; }
.proof > h3 { font-size:13px; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); }
details.src { margin:4px 0; }
details.src summary { cursor:pointer; font-family:ui-monospace,Menlo,monospace; font-size:13px; color:var(--accent); }
