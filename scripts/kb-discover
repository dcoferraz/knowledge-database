#!/bin/bash
# Deprecated shim. Discovery now lives in the CLI that ships inside every KB
# folder: `knowledge-db/bin/kb discover <dir>`. Before v0.7.0 this script was
# referenced by AGENT.md but never installed anywhere, so agents were told to
# run a tool no install had. Kept so older docs and scripts keep working.
KB_DIR=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -k|--kb-dir) KB_DIR="${2:-}"; shift 2 ;;
        --kb-dir=*)  KB_DIR="${1#*=}"; shift ;;
        -o|--output) ARGS+=("--output" "${2:-}"); shift 2 ;;
        *)           ARGS+=("$1"); shift ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "$KB_DIR/bin/kb" "knowledge-db/bin/kb" "$(dirname "$SCRIPT_DIR")/knowledge-db/bin/kb"; do
    [[ -n "$candidate" && -x "$candidate" ]] && KB="$candidate" && break
done
[[ -z "${KB:-}" ]] && { echo "kb-discover: cannot find knowledge-db/bin/kb" >&2; exit 1; }
if [[ -n "$KB_DIR" ]]; then
    exec "$KB" --kb-dir "$KB_DIR" discover "${ARGS[@]}"
fi
exec "$KB" discover "${ARGS[@]}"
