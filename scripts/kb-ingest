#!/bin/bash
# Deprecated shim. Ingestion now lives in the CLI that ships inside every KB
# folder: `knowledge-db/bin/kb ingest`. See scripts/kb-discover for why.
KB_DIR=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -k|--kb-dir) KB_DIR="${2:-}"; shift 2 ;;
        --kb-dir=*)  KB_DIR="${1#*=}"; shift ;;
        *)           ARGS+=("$1"); shift ;;
    esac
done
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for candidate in "$KB_DIR/bin/kb" "knowledge-db/bin/kb" "$(dirname "$SCRIPT_DIR")/knowledge-db/bin/kb"; do
    [[ -n "$candidate" && -x "$candidate" ]] && KB="$candidate" && break
done
[[ -z "${KB:-}" ]] && { echo "kb-ingest: cannot find knowledge-db/bin/kb" >&2; exit 1; }
if [[ -n "$KB_DIR" ]]; then
    exec "$KB" --kb-dir "$KB_DIR" ingest "${ARGS[@]}"
fi
exec "$KB" ingest "${ARGS[@]}"
